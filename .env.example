# ----------------------------------------------------
# DeepTrust AI - Environment Configuration Example
# ----------------------------------------------------

# Flask Environment ('development' or 'production')
FLASK_ENV=production
FLASK_DEBUG=False
PORT=5000
HOST=0.0.0.0

# Security Secret Key
SECRET_KEY=generate-a-strong-random-hex-string-for-production-here

# Managed PostgreSQL Database URL
# Example: postgresql://postgres:password@db.xyz.supabase.co:5432/postgres
# Or from Render / Railway: postgresql://user:pass@host:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/deeptrust_db

# Cloudinary Cloud Object Storage
# Get this from your Cloudinary dashboard: https://cloudinary.com
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Or individual credentials:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Upload Limits (32MB in bytes)
MAX_CONTENT_LENGTH=33554432

# Hugging Face Model Repository Configuration (UCF-Net 2.44GB Model)
# Model is automatically fetched at runtime from Hugging Face and cached locally.
HF_MODEL_REPO=PranjalSeluriyal/Deepfake_Detection
HF_MODEL_FILENAME=model_best.pth
HF_TOKEN=

# Model Loading Overrides (Optional)
# Set to 'false' on serverless environments to disable synchronous startup preloading
PRELOAD_MODELS=true
# Point to custom local model file if you have pre-downloaded weights (overrides HF download)
# IMAGE_MODEL_PATH=models/ucfnet/model_best.pth

# Dedicated ML Backend URL (Optional)
# If deploying the frontend/API proxy on Vercel while running the heavy ML model on Render/Railway/GPU:
# BACKEND_API_URL=https://your-backend-service.onrender.com
